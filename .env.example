# Copiez ce fichier en ".env" (jamais commite) et remplissez vos identifiants
# obtenus sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Utilise en local uniquement : sur Railway (et la plupart des hebergeurs),
# la variable PORT est fournie automatiquement et prime sur celle-ci.
SERVER_PORT=5057

# Mot de passe pour acceder a la page d'administration (/admin)
ADMIN_PASSWORD=
# Cle secrete pour signer les sessions admin (une longue chaine aleatoire)
SESSION_SECRET=
# A mettre a "production" sur l'hebergement (active le cookie de session "secure")
NODE_ENV=
